FROM python:3.12-slim

# Prevent interactive debconf prompts and Python bytecode buffering
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH="/workspace:/workspace/apps/api"

# Install system dependencies including TShark CLI and network tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    tshark \
    tcpdump \
    curl \
    iproute2 \
    procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Install Python requirements
COPY apps/api/requirements.txt /workspace/apps/api/requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /workspace/apps/api/requirements.txt

# Copy application and services code
COPY apps/api /workspace/apps/api
COPY services /workspace/services
COPY datasets /workspace/datasets
COPY storage /workspace/storage

# Create storage directory for uploaded PCAPs
RUN mkdir -p /workspace/storage/pcaps /workspace/storage/reports

WORKDIR /workspace/apps/api

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
