# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Simulation & Prototype Controls
# When true, the platform operates in simulation mode with realistic mock analysis data
SIMULATION_MODE=true
DEFAULT_SIMULATION_SCENARIO=secure-enterprise

# API Service Configuration (apps/api)
API_HOST=0.0.0.0
API_PORT=8000

# Web Frontend Configuration (apps/web)
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SIMULATION_MODE=true

# PostgreSQL Database Configuration
POSTGRES_USER=abhedyax
POSTGRES_PASSWORD=abhedyax_secret
POSTGRES_DB=abhedyax_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Cache and Asynchronous Job Broker
REDIS_URL=redis://localhost:6379/0

# Local Storage Directories (Relative to repository root)
STORAGE_PCAP_DIR=storage/pcaps
STORAGE_REPORTS_DIR=storage/reports
