# AbhedyaX Environment Configuration
# Copy to .env: cp .env.example .env

# === API Service ===
APP_ENV=production
API_PORT=8000
SIMULATION_MODE=true

# Analysis Engine: mock (safe default) | real (requires TShark in host environment)
ABHEDYAX_ANALYSIS_ENGINE=mock

LOG_LEVEL=INFO

# === Web Service ===
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SIMULATION_MODE=true

# Frontend Runtime Data Provider Mode: demo | auto | api
# Default 'demo' allows standalone Vercel deployment with zero reliance on backend availability
NEXT_PUBLIC_DATA_MODE=demo
