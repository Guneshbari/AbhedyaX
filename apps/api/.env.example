APP_NAME="AbhedyaX API"
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SIMULATION_MODE=true
STEP_DELAY_SECONDS=0.4
LOG_LEVEL=INFO

# Phase 2 — Analysis Engine
# Options: mock | real
ABHEDYAX_ANALYSIS_ENGINE=mock
TSHARK_BINARY=tshark
TSHARK_TIMEOUT_SECONDS=120
MAX_PCAP_SIZE_MB=250
STORAGE_DIR=storage
