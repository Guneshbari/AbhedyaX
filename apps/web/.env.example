# AbhedyaX Frontend Environment Configuration
# Copy this file to .env.local for local overrides: cp .env.example .env.local

# Runtime Data Provider Mode:
# - demo (Default & Recommended for Vercel demo/PPT shortlisting): zero latency, 100% offline-ready canonical dataset
# - auto: Starts instantly with demo, probes backend in background, seamlessly upgrades to API if healthy
# - api: Direct REST calls to FastAPI backend
NEXT_PUBLIC_DATA_MODE=demo

# Backend API Endpoint URL (optional when NEXT_PUBLIC_DATA_MODE=demo)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Enable simulation mode badge and pre-configured scenarios
NEXT_PUBLIC_SIMULATION_MODE=true
